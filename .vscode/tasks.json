{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/VEILRUN.csproj", "-nologo", "-v", "q"],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "tests (headless)",
      "type": "shell",
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/run_tests.ps1"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
